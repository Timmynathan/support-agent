# Copy to .env and fill in. Server-side only — never prefix any of these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used ONLY by scripts/guard-tests.ts to prove the public anon key can read nothing.
# This project never ships it to a browser.
SUPABASE_ANON_KEY=

# ── Voice (Phase 3) ──────────────────────────────────────────────
# Server-side only:
VAPI_PRIVATE_KEY=            # used only by scripts/vapi-setup.ts
VAPI_LLM_SECRET=             # random; also saved in Vapi as the Custom LLM provider key
VAPI_WEBHOOK_SECRET=         # random; also saved in Vapi as the webhook credential's HMAC secret
VAPI_WEBHOOK_CREDENTIAL_ID=  # id of that webhook credential in Vapi
PUBLIC_URL=                  # the tunnel URL, e.g. https://xxxx.trycloudflare.com
# Public by Vapi's design (sent to the browser widget via /config.json):
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
